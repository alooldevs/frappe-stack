# How this bench's image is built.
#
# Public upstream Frappe:
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH=version-16
#
# A private repo (fork) over SSH, through a keyup alias on this server:
# FRAPPE_PATH=git@github-ACCOUNT:OWNER/frappe.git
# FRAPPE_BRANCH=BRANCH
#
# Frappe version-16 and develop need Python 3.14 and Node 24.
PYTHON_VERSION=3.14
NODE_VERSION=24
